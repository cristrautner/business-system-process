# Public address of the app, used for the Google sign-in callback and the connect links.
APP_URL=https://followup.example.com

# Inside the container. docker-compose.yml maps it to 127.0.0.1:3010 on the VPS.
PORT=3000
DATABASE_PATH=data/app.db

# Login for the agency dashboard.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Encrypts stored Google tokens. Generate with: openssl rand -base64 32
# Keep a copy somewhere safe. Losing it means every client has to reconnect Google.
TOKEN_KEY=

# From Google Cloud Console > APIs & Services > Credentials (OAuth client, type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# From Resend > API Keys. Sending access is enough.
RESEND_API_KEY=

# Nothing is emailed to anyone until this is set to false.
DRY_RUN=true

# How often to check calendars and send due emails, in seconds.
POLL_INTERVAL_SECONDS=300
SEND_INTERVAL_SECONDS=60

# How often to locate new customers, look for last night's hail, and send approved storm emails, in seconds.
STORM_INTERVAL_SECONDS=600
